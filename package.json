{
  "name": "@lxagents-skills/security",
  "version": "2.0.3",
  "description": "Read-only Skill MCP server delivering the global security instruction set for python, javascript/typescript, and go.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lxagents-security": "dist/cli.js",
    "lxagents-security-server": "dist/index.js"
  },
  "files": [
    "dist",
    "content",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc -p test/tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/cli.js serve --http --host 127.0.0.1",
    "cli": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "LXAgents",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-Skills/security.git"
  },
  "homepage": "https://github.com/LXAgents-Skills/security#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-Skills/security/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "agent-instructions",
    "lxagents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
